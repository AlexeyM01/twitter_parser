# ---- Telegram, основной режим: бот (my.telegram.org НЕ нужен) ----
# Токен бота: в Telegram найдите @BotFather -> /newbot -> скопируйте токен
TELEGRAM_BOT_TOKEN=
# Канал: @username или числовой id (для приватного канала)
# Бот должен быть добавлен в канал администратором с правом «Публикация сообщений»
TELEGRAM_CHANNEL=@my_shams_channel

# ---- Telegram, опциональный режим: личный аккаунт (Telethon) ----
# Используется только если TELEGRAM_BOT_TOKEN пуст. Требует api_id/api_hash
# с https://my.telegram.org и строку сессии (python generate_session.py)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# ---- Источник RSS (см. README, раздел про источник) ----
# Свои инстансы RSSHub через запятую (проверяются по очереди):
RSSHUB_INSTANCES=https://rsshub.app,https://rsshub.rssforever.com,https://rsshub.pseudoyu.com,https://rsshub.ktachibana.party,https://rsshub.moeyy.cn
# Или один готовый RSS-URL своего RSSHub — имеет приоритет:
CUSTOM_RSS_URL=

# ---- Поведение ----
# Сколько постов публиковать за один запуск (защита от флуда)
MAX_POSTS_PER_RUN=5
# Посты старше N часов не публикуются (после простоя)
MAX_AGE_HOURS=24
# Пропускать ретвиты
SKIP_RETWEETS=true

# ---- Перевод ----
# google_free = бесплатный Google-переводчик (без ключа)
# deepl       = DeepL API (стабильнее, ключ ниже, free-ключ оканчивается на ":fx")
# off         = без перевода, публикуется оригинал
TRANSLATOR=google_free
DEEPL_API_KEY=

# ---- Прочее ----
# Файл состояния (коммитится GitHub Actions обратно в репозиторий)
STATE_FILE=state.json
# Локальный RSS-файл для теста форматирования без сети (TEST_FEED=sample_feed.xml)
TEST_FEED=
