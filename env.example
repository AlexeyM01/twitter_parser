# =============================================================
# Ключи NBA-парсера.
# Скопируй этот файл в .env, заполни и положи рядом с deploy.sh:
#   cp .env.example .env && nano .env
# deploy.sh проверит его и установит на сервер автоматически.
# НИКОГДА не коммить .env в git и не пересылай в чатах.
# =============================================================

# Токен Apify Console (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

# Имя или ID актора Apify, например "user~x-tweet-scraper"
ACTOR_ID=

# Токен бота от @BotFather (вида 123456789:AA...)
TG_BOT_TOKEN=

# ID канала/чата Telegram. Для канала: -100xxxxxxxxxx
# (узнать: добавить бота в канал и открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates)
TG_CHAT_ID=
